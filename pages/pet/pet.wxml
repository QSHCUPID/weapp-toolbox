<view class="container">
  <view class="header">
    <view class="title-area">
      <text class="emoji">🐕</text>
      <text class="title">棠棠成长日记</text>
    </view>
    <text class="subtitle">记录毛茸茸的每一天</text>
    <text class="description">分享可爱、温馨、快乐的瞬间 ✨</text>
  </view>
  
  <view class="stats-section">
    <view class="stats-title">成长统计</view>
    <view class="stats-grid">
      <view class="stat-item">
        <text class="stat-icon">📸</text>
        <text class="stat-number">{{stats.totalPosts}}</text>
        <text class="stat-label">总动态数</text>
      </view>
      <view class="stat-item">
        <text class="stat-icon">🖼️</text>
        <text class="stat-number">{{stats.photos}}</text>
        <text class="stat-label">照片数</text>
      </view>
      <view class="stat-item">
        <text class="stat-icon">🎬</text>
        <text class="stat-number">{{stats.videos}}</text>
        <text class="stat-label">视频数</text>
      </view>
      <view class="stat-item">
        <text class="stat-icon">❤️</text>
        <text class="stat-number">{{stats.likes}}</text>
        <text class="stat-label">获赞数</text>
      </view>
    </view>
  </view>
  
  <view class="publish-btn-section">
    <button class="publish-btn" bindtap="goToPublish">
      <text class="btn-icon">✨</text>
      <text>发布新动态</text>
    </button>
  </view>
  
  <view class="moments-section">
    <view class="section-title">可爱瞬间</view>
    <view class="empty-state" wx:if="{{moments.length === 0}}">
      <text class="empty-icon">🐾</text>
      <text class="empty-text">还没有动态，快去发布第一条吧～</text>
    </view>
    <view class="moments-list" wx:else>
      <view class="moment-card" wx:for="{{moments}}" wx:key="id">
        <view class="moment-content" wx:if="{{item.content}}">{{item.content}}</view>
        <view class="moment-photos" wx:if="{{item.photos && item.photos.length > 0}}">
          <image 
            class="moment-photo" 
            wx:for="{{item.photos}}" 
            wx:for-item="photo"
            wx:for-index="photoIndex"
            wx:key="*this"
            src="{{photo}}" 
            mode="aspectFill"
          />
        </view>
        <view class="moment-videos" wx:if="{{item.videos && item.videos.length > 0}}">
          <video 
            class="moment-video" 
            wx:for="{{item.videos}}" 
            wx:for-item="video"
            wx:for-index="videoIndex"
            wx:key="*this"
            src="{{video}}"
            controls
          />
        </view>
        <view class="moment-footer">
          <text class="moment-time">{{item.createdAt}}</text>
          <view class="moment-actions">
            <view class="action-item" data-id="{{item.id}}" bindtap="likeMoment">
              <text class="action-icon">❤️</text>
              <text class="action-count">{{item.likes || 0}}</text>
            </view>
          </view>
        </view>
      </view>
    </view>
  </view>
</view>

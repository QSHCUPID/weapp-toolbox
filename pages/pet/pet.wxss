.container {
  min-height: 100vh;
  background: linear-gradient(180deg, #ffecd2 0%, #fcb69f 100%);
  padding-bottom: 40rpx;
}

.header {
  text-align: center;
  padding: 60rpx 40rpx 40rpx;
}

.title-area {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 20rpx;
}

.emoji {
  font-size: 64rpx;
  margin-right: 20rpx;
}

.title {
  font-size: 48rpx;
  font-weight: bold;
  color: #8b4513;
}

.subtitle {
  display: block;
  font-size: 28rpx;
  color: #a0522d;
  margin-bottom: 10rpx;
}

.description {
  font-size: 26rpx;
  color: #cd853f;
}

.stats-section {
  margin: 0 30rpx 40rpx;
  background: rgba(255, 255, 255, 0.9);
  border-radius: 24rpx;
  padding: 40rpx;
  box-shadow: 0 8rpx 30rpx rgba(139, 69, 19, 0.1);
}

.stats-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #8b4513;
  text-align: center;
  margin-bottom: 40rpx;
}

.stats-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 30rpx;
}

.stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 30rpx 20rpx;
  background: linear-gradient(135deg, #fff5e6 0%, #ffe4c4 100%);
  border-radius: 20rpx;
}

.stat-icon {
  font-size: 48rpx;
  margin-bottom: 15rpx;
}

.stat-number {
  font-size: 40rpx;
  font-weight: bold;
  color: #8b4513;
  margin-bottom: 8rpx;
}

.stat-label {
  font-size: 24rpx;
  color: #a0522d;
}

.moments-section {
  margin: 0 30rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #8b4513;
  margin-bottom: 30rpx;
  padding-left: 10rpx;
}

.empty-state {
  background: rgba(255, 255, 255, 0.9);
  border-radius: 24rpx;
  padding: 80rpx 40rpx;
  text-align: center;
}

.empty-icon {
  display: block;
  font-size: 80rpx;
  margin-bottom: 20rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #a0522d;
}

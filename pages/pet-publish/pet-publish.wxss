.container {
  min-height: 100vh;
  background: #f5f5f5;
  padding: 30rpx;
}

.content-section {
  background: white;
  border-radius: 20rpx;
  padding: 30rpx;
  margin-bottom: 30rpx;
}

.input-label {
  font-size: 28rpx;
  color: #666;
  margin-bottom: 15rpx;
}

.title-input {
  width: 100%;
  font-size: 32rpx;
  padding: 15rpx 0;
  border-bottom: 1rpx solid #eee;
}

.content-input {
  width: 100%;
  min-height: 200rpx;
  font-size: 32rpx;
  line-height: 1.6;
}

.char-count {
  text-align: right;
  font-size: 24rpx;
  color: #999;
  margin-top: 20rpx;
}

.media-section {
  background: white;
  border-radius: 20rpx;
  padding: 30rpx;
  margin-bottom: 30rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 30rpx;
}

.media-preview {
  position: relative;
}

.preview-img {
  width: 100%;
  max-height: 600rpx;
  border-radius: 12rpx;
}

.preview-video {
  width: 100%;
  border-radius: 12rpx;
}

.remove-media {
  position: absolute;
  top: -10rpx;
  right: -10rpx;
  width: 50rpx;
  height: 50rpx;
  background: #ff4d4f;
  color: white;
  border-radius: 50%;
  font-size: 36rpx;
  line-height: 46rpx;
  text-align: center;
  z-index: 10;
}

.media-choices {
  display: flex;
  gap: 20rpx;
}

.choice-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 50rpx 20rpx;
  border: 2rpx dashed #ddd;
  border-radius: 16rpx;
  background: #fafafa;
}

.choice-icon {
  font-size: 60rpx;
  margin-bottom: 15rpx;
}

.choice-text {
  font-size: 26rpx;
  color: #666;
}

.publish-section {
  margin-top: 60rpx;
}

.publish-btn {
  width: 100%;
  height: 100rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: white;
  font-size: 36rpx;
  font-weight: 600;
  border-radius: 50rpx;
  border: none;
}

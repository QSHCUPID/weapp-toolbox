<view class="container">
  <view class="content-section">
    <view class="input-label">标题</view>
    <input 
      class="title-input" 
      placeholder="给动态起个标题吧..." 
      value="{{title}}"
      bindinput="inputTitle"
      maxlength="50"
    />
  </view>
  
  <view class="content-section">
    <view class="input-label">内容</view>
    <textarea 
      class="content-input" 
      placeholder="记录棠棠的可爱瞬间..." 
      value="{{content}}"
      bindinput="inputContent"
      maxlength="500"
      auto-height
    />
    <view class="char-count">{{content.length}}/500</view>
  </view>
  
  <view class="media-section">
    <view class="section-title">照片/视频</view>
    <view class="media-preview" wx:if="{{tempMediaPath}}">
      <image wx:if="{{tempMediaType === 'image'}}" src="{{tempMediaPath}}" class="preview-img" mode="aspectFill" />
      <video wx:else src="{{tempMediaPath}}" class="preview-video" controls />
      <view class="remove-media" bindtap="removeMedia">×</view>
    </view>
    <view class="media-choices" wx:else>
      <view class="choice-item" bindtap="chooseImage">
        <text class="choice-icon">📷</text>
        <text class="choice-text">添加照片</text>
      </view>
      <view class="choice-item" bindtap="chooseVideo">
        <text class="choice-icon">🎬</text>
        <text class="choice-text">添加视频</text>
      </view>
    </view>
  </view>
  
  <view class="publish-section">
    <button class="publish-btn" bindtap="publish">发布动态</button>
  </view>
</view>

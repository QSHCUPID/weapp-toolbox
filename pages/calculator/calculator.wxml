<view class="calculator">
  <view class="display-area">
    <view class="formula">{{formula}}</view>
    <view class="display">{{display}}</view>
  </view>
  
  <view class="buttons">
    <view class="row">
      <button class="btn btn-clear" bindtap="clear">AC</button>
      <button class="btn btn-operator" bindtap="delete">⌫</button>
      <button class="btn btn-operator" data-operator="%" bindtap="appendOperator">%</button>
      <button class="btn btn-operator" data-operator="÷" bindtap="appendOperator">÷</button>
    </view>
    
    <view class="row">
      <button class="btn btn-number" data-num="7" bindtap="appendNumber">7</button>
      <button class="btn btn-number" data-num="8" bindtap="appendNumber">8</button>
      <button class="btn btn-number" data-num="9" bindtap="appendNumber">9</button>
      <button class="btn btn-operator" data-operator="×" bindtap="appendOperator">×</button>
    </view>
    
    <view class="row">
      <button class="btn btn-number" data-num="4" bindtap="appendNumber">4</button>
      <button class="btn btn-number" data-num="5" bindtap="appendNumber">5</button>
      <button class="btn btn-number" data-num="6" bindtap="appendNumber">6</button>
      <button class="btn btn-operator" data-operator="-" bindtap="appendOperator">-</button>
    </view>
    
    <view class="row">
      <button class="btn btn-number" data-num="1" bindtap="appendNumber">1</button>
      <button class="btn btn-number" data-num="2" bindtap="appendNumber">2</button>
      <button class="btn btn-number" data-num="3" bindtap="appendNumber">3</button>
      <button class="btn btn-operator" data-operator="+" bindtap="appendOperator">+</button>
    </view>
    
    <view class="row">
      <button class="btn btn-zero btn-number" data-num="0" bindtap="appendNumber">0</button>
      <button class="btn btn-number" data-num="." bindtap="appendNumber">.</button>
      <button class="btn btn-equals" bindtap="calculate">=</button>
    </view>
  </view>
</view>
